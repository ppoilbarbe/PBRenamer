msgstr "``--mode {pattern,regex,plain}``"

# ==AUTO== Automatically translated
msgid "Search mode: ``pattern`` (default), ``regex``, or ``plain``."
msgstr "Modalità di ricerca: ``pattern`` (predefinito), ``regex`` o ``plain``."

