msgstr "Fichier"

msgid "Edit"
msgstr "Édition"

msgid "Profile"
msgstr "Profil"

msgid "Images"
msgstr "Images"

msgid "Open sidecar"
msgstr "Ouvrir le sidecar"

msgid "Shortcuts"
msgstr "Raccourcis"

